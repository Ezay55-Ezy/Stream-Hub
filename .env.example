# PostgreSQL database connection string
DATABASE_URL=postgres://user:password@host:5432/streamhub

# Telegram API credentials (get from https://my.telegram.org/apps)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=your_api_hash_here

# Optional: pre-authenticated Telegram session string
# TELEGRAM_SESSION=

# Server port
PORT=3001

# Mobile app: your server's public domain (for Expo)
EXPO_PUBLIC_DOMAIN=your-app.replit.app

# Log level (trace, debug, info, warn, error, fatal)
# LOG_LEVEL=info
