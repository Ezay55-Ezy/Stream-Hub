{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22",
      "installCommand": "npm install -g corepack@latest --force && corepack enable && pnpm install --frozen-lockfile --filter=artifacts/mobile...",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "streamgram-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
